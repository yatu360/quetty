STAGING_URL=https://staging.example.test
TARGET_QUEUE_IDS=1000
SESSION_MODE=HYBRID
# Browser backend for NEW runs (Phase 7 policy):
#   patchright - default; Patchright 1.63.0 driving installed Google Chrome. Needs
#                Google Chrome installed; check with queue-load-test-patchright-preflight.
#   chrome     - supported fallback/control; standard Playwright with installed Chrome.
#   camoufox   - retained, dormant/experimental, NOT certified by Phase 7 and not
#                recommended. Needs its pinned build first:
#                camoufox fetch official/stable/152.0.4-beta.30
# An existing run always restarts with the backend recorded when it was created;
# changing this value never migrates it. Use Stop & Reset Run to switch backends.
BROWSER_BACKEND=patchright
# Default selection shown for NEW runs only. The setup choice is persisted and an
# existing run always restarts with it; use Stop & Reset Run to choose differently.
# headed_window keeps the existing browser restore + live page inspection path.
# direct is a Phase 8 provenance choice and currently uses browser fallback.
MONITORING_STRATEGY=headed_window
# Opt-in sensitive browser-network evidence for Direct Monitoring Strategy runs only.
# Artifacts can contain visitor credentials; keep them local and never commit/share raw.
STATUS_DISCOVERY_ENABLED=false
STATUS_DISCOVERY_DIRECTORY=.status-discovery
# Use authorized_queue_it_staging only for an explicitly authorised run.
STATUS_DISCOVERY_SCOPE=diagnostic_unverified_target
STATUS_DISCOVERY_CONFIRM_AUTHORIZED_STAGING=false
STATUS_DISCOVERY_MAX_EXCHANGES=100
STATUS_DISCOVERY_MAX_BODY_BYTES=65536
STATUS_DISCOVERY_EVENT_QUEUE_CAPACITY=100
STATUS_DISCOVERY_CLEANUP_TIMEOUT_SECONDS=5.0
# Diagnostic-only dwell so periodic visitor-page requests can occur before re-parking.
STATUS_DISCOVERY_OBSERVE_SECONDS=30.0
# Direct Monitoring Strategy (Phase 8 Prompt 5). Recipes and response cookies stay in
# this protected, git-ignored directory. Without a reviewed schema every Direct-run
# check uses the browser fallback. Real targets accept only
# authorized_queue_it_staging schema/discovery evidence.
DIRECT_MONITOR_DIRECTORY=.direct-monitor
DIRECT_MONITOR_SCHEMA_PATH=
DIRECT_MONITOR_TIMEOUT_SECONDS=10.0
DIRECT_MONITOR_MAX_RESPONSE_BYTES=65536
DIRECT_MONITOR_FAILURE_THRESHOLD=3
# Wait before re-adopting a recipe after a session becomes DIRECT_UNAVAILABLE.
DIRECT_MONITOR_READOPT_COOLDOWN_SECONDS=300.0
# Newest credential-bearing discovery artifacts kept per session (0 keeps all).
DIRECT_MONITOR_DISCOVERY_RETENTION=5
# Browser processes per pool (historical name; applies to every backend). Camoufox
# runs one live context per process, so this is also its automatic concurrency.
CHROME_PROCESS_COUNT=2
MAX_CONTEXTS_PER_BROWSER=25
MAX_ACTIVE_CONTEXTS=50
CREATION_WORKERS=1
CREATION_QUEUE_CAPACITY=5
# Acquired Queue IDs that later FAIL are not refilled beyond this many replacements.
IDENTITY_REPLACEMENT_LIMIT=0
MONITOR_WORKERS=1
MONITOR_QUEUE_CAPACITY=5
MONITOR_CLAIM_BATCH_SIZE=5
MONITOR_LEASE_SECONDS=120.0
MONITOR_SCHEDULER_TICK_SECONDS=1.0
MONITOR_RETRY_MAX_ATTEMPTS=3
MONITOR_RETRY_INITIAL_BACKOFF_SECONDS=0.5
MONITOR_RETRY_MAX_BACKOFF_SECONDS=5.0
MONITOR_RETRY_JITTER_SECONDS=0.25
ADMISSION_WAIT_SECONDS=5.0
SHUTDOWN_TIMEOUT_SECONDS=30.0
QUEUE_POLL_SECONDS=30.0
POLL_JITTER_SECONDS=5.0
PRE_QUEUE_POLL_MIN_SECONDS=60.0
PRE_QUEUE_POLL_MAX_SECONDS=300.0
ACTIVE_EARLY_POLL_MIN_SECONDS=60.0
ACTIVE_EARLY_POLL_MAX_SECONDS=120.0
ACTIVE_MID_POLL_MIN_SECONDS=30.0
ACTIVE_MID_POLL_MAX_SECONDS=60.0
SERVICED_SOON_POLL_MIN_SECONDS=10.0
SERVICED_SOON_POLL_MAX_SECONDS=30.0
ACTIVE_MID_PROGRESS_PERCENTAGE=50.0
TURN_STARTED_POLL_SECONDS=0.0
STALE_UPDATE_SECONDS=180.0
HEADLESS=true
CREATION_HEADLESS=false
DATABASE_URL=sqlite:///queue_load_test.sqlite3
STATE_DIRECTORY=.browser-state
PROMETHEUS_PORT=9090
UI_HOST=127.0.0.1
UI_PORT=8000
# Operator-entered run targets cannot exceed this safety ceiling.
MAX_MANUAL_REQUESTED_SESSIONS=10000
# Headed contexts share MAX_ACTIVE_CONTEXTS with automatic browser work. Camoufox
# gives each open window its own process, so this also caps headed Camoufox processes.
MAX_MANUAL_OPEN_SESSIONS=5
MANUAL_OPEN_LEASE_SECONDS=30.0
# Browser-backed operator actions use a fixed worker pool and bounded request queue.
OPERATOR_WORKERS=2
OPERATOR_QUEUE_CAPACITY=10
OPERATOR_LEASE_SECONDS=300.0

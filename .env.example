STAGING_URL=https://staging.example.test
TARGET_QUEUE_IDS=1000
SESSION_MODE=HYBRID
CHROME_PROCESS_COUNT=2
MAX_CONTEXTS_PER_BROWSER=25
MAX_ACTIVE_CONTEXTS=50
CREATION_WORKERS=1
CREATION_QUEUE_CAPACITY=5
# Acquired Queue IDs that later FAIL are not refilled beyond this many replacements.
IDENTITY_REPLACEMENT_LIMIT=0
MONITOR_WORKERS=1
MONITOR_QUEUE_CAPACITY=5
MONITOR_CLAIM_BATCH_SIZE=5
MONITOR_LEASE_SECONDS=120.0
MONITOR_SCHEDULER_TICK_SECONDS=1.0
MONITOR_RETRY_MAX_ATTEMPTS=3
MONITOR_RETRY_INITIAL_BACKOFF_SECONDS=0.5
MONITOR_RETRY_MAX_BACKOFF_SECONDS=5.0
MONITOR_RETRY_JITTER_SECONDS=0.25
ADMISSION_WAIT_SECONDS=5.0
SHUTDOWN_TIMEOUT_SECONDS=30.0
QUEUE_POLL_SECONDS=30.0
POLL_JITTER_SECONDS=5.0
PRE_QUEUE_POLL_MIN_SECONDS=60.0
PRE_QUEUE_POLL_MAX_SECONDS=300.0
ACTIVE_EARLY_POLL_MIN_SECONDS=60.0
ACTIVE_EARLY_POLL_MAX_SECONDS=120.0
ACTIVE_MID_POLL_MIN_SECONDS=30.0
ACTIVE_MID_POLL_MAX_SECONDS=60.0
SERVICED_SOON_POLL_MIN_SECONDS=10.0
SERVICED_SOON_POLL_MAX_SECONDS=30.0
ACTIVE_MID_PROGRESS_PERCENTAGE=50.0
TURN_STARTED_POLL_SECONDS=0.0
STALE_UPDATE_SECONDS=180.0
HEADLESS=true
DATABASE_URL=sqlite:///queue_load_test.sqlite3
STATE_DIRECTORY=.browser-state
PROMETHEUS_PORT=9090
